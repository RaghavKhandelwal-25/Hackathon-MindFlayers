# Groq API Configuration
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (configurable, e.g. openai/gpt-oss-120b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# RAG Retrieval Configuration
# Cosine similarity relevance threshold (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.35

# Number of top chunks to retrieve (4 to 5)
TOP_K=4
